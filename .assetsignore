# Files Cloudflare should NOT publish as part of the site.
# Same format as .gitignore. Without this, the whole .git directory
# is served publicly at samuihonestly.com/.git/

**/.git
**/.github
**/.wrangler
**/node_modules
**/.DS_Store
**/Thumbs.db

# Repo files that belong on GitHub, not on the live site
README.md
PHASE3.md
.gitignore
.assetsignore
wrangler.jsonc

# Phase 3 — server-side code and pipeline. These run, they are not served.
worker/
pipeline/
dbt/
data/
